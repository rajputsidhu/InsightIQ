# InsightIQ Environment Configuration Template

# Optional PostgreSQL Analytical Storage (defaults to high-speed in-memory DuckDB if unconfigured)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insightiq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Application Configuration
APP_ENV=development
MAX_UPLOAD_SIZE_MB=50
ENABLE_QUERY_CACHE=true

# Optional LLM Key for Executive Summarization (Core platform works completely without key)
LLM_API_KEY=
